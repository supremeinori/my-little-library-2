#include <windows.h>

#define IDI_APP_ICON 101

// Application Icon
IDI_APP_ICON ICON "app.ico"

// Application Manifest
1 24 "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,2,1,0
PRODUCTVERSION  2,2,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "My Little Library\0"
            VALUE "FileDescription",  "My Little Library — Windows Desktop Edition\0"
            VALUE "FileVersion",      "2.2.1.0\0"
            VALUE "InternalName",     "MyLittleLibrary\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 My Little Library Contributors\0"
            VALUE "OriginalFilename", "MyLittleLibrary.exe\0"
            VALUE "ProductName",      "My Little Library\0"
            VALUE "ProductVersion",   "2.2.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
